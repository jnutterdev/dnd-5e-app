// schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ------------------------------------------------------
// User & Auth Models (Compatible with Auth.js / NextAuth)
// ------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  role          UserRole  @default(USER)

  accounts Account[]
  sessions Session[]

  // App Specific Relations
  characters        Character[]
  createdCampaigns  Campaign[]        @relation("DMCampaigns")
  campaignMembers   CampaignMember[]
  notes             CampaignNote[]
  compendiumEntries CompendiumEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

// ------------------------------------------------------
// D&D Core App Models
// ------------------------------------------------------

model Character {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Campaign Association (Optional - a character can exist without a campaign)
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  // Basic Information
  name       String
  race       String
  subrace    String?
  class      String
  archetype  String? // e.g., Evocation Wizard, Circle of the Moon
  level      Int     @default(1)
  alignment  String?
  background String?
  avatarUrl  String?

  // Stats & Combat State
  maxHp            Int
  currentHp        Int
  tempHp           Int @default(0)
  armorClass       Int
  speed            Int @default(30)
  proficiencyBonus Int @default(2)

  // JSON Data Structures for Flexibility
  // abilityScores: { str: 15, dex: 14, con: 13, int: 12, wis: 10, cha: 8 }
  abilityScores Json

  // savingThrows / skills: ["perception", "stealth"]
  proficientSkills         Json @default("[]")
  savingThrowProficiencies Json @default("[]")

  // spellSlots: { level1: { total: 4, used: 1 }, level2: { total: 2, used: 0 } }
  spellSlots Json @default("{}")

  // inventory: Array of item objects [{ name: "Longsword", quantity: 1, equipped: true }]
  inventory Json @default("[]")

  // Notes & Lore
  backstory   String? @db.Text
  personality String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([campaignId])
}

enum Role {
  DM
  PLAYER
}

model Campaign {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String? @db.Text
  inviteCode  String  @unique // 6-character unique join code

  // DM / Creator
  dmId String @db.Uuid
  dm   User   @relation("DMCampaigns", fields: [dmId], references: [id], onDelete: Restrict)

  // Members & Characters
  members    CampaignMember[]
  characters Character[]
  notes      CampaignNote[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([dmId])
}

model CampaignMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @default(PLAYER)

  joinedAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([campaignId, userId])
}

model CampaignNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  title    String
  content  Json // TipTap / BlockNote JSON format for rich text
  isDmOnly Boolean @default(false) // Secrets / DM-only view filter

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([campaignId])
  @@index([authorId])
}

// ------------------------------------------------------
// Unified Compendium & World Lore Models
// ------------------------------------------------------

enum CompendiumCategory {
  LORE
  FACTION
  PANTHEON
  BESTIARY
  RELIC
  LOCATION
}

model CompendiumEntry {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String             @unique // e.g. "lady-of-pain", "harmonium"
  title       String
  category    CompendiumCategory
  summary     String?            @db.Text
  content     Json // Rich text (TipTap/BlockNote) or Markdown JSON
  imageUrl    String?
  tags        Json               @default("[]") // ["outer-planes", "deity"]
  isPublished Boolean            @default(true)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([category])
  @@index([authorId])
}
