// schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ------------------------------------------------------
// User & Auth Models (Better Auth core schema)
// Field names must match Better Auth; see docs/specs/auth.md
// ------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER) // Better Auth additionalField, input: false

  accounts Account[]
  sessions Session[]

  // App Specific Relations
  characters        Character[]
  createdCampaigns  Campaign[]        @relation("DMCampaigns")
  campaignMembers   CampaignMember[]
  notes             CampaignNote[]
  gameSessions      GameSession[]
  compendiumEntries CompendiumEntry[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String // provider's user ID (Discord user ID)
  providerId            String // "discord"
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ------------------------------------------------------
// D&D Core App Models
// ------------------------------------------------------

enum CharacterStatus {
  ACTIVE
  DEAD
  RETIRED
}

model Character {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Campaign Association (Optional - a character can exist without a campaign)
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  // Basic Information
  name       String
  race       String
  subrace    String?
  alignment  String?
  background String?
  avatarUrl  String?
  status     CharacterStatus @default(ACTIVE)

  // Total level and proficiency bonus are derived from `classes` in app code
  classes CharacterClass[]

  // Stats & Combat State
  maxHp      Int
  currentHp  Int
  tempHp     Int @default(0)
  armorClass Int
  speed      Int @default(30)

  // JSON Data Structures for Flexibility
  // abilityScores: { str: 15, dex: 14, con: 13, int: 12, wis: 10, cha: 8 }
  abilityScores Json

  // savingThrows / skills: ["perception", "stealth"]
  proficientSkills         Json @default("[]")
  savingThrowProficiencies Json @default("[]")

  // spellSlots: { level1: { total: 4, used: 1 }, level2: { total: 2, used: 0 } }
  spellSlots Json @default("{}")

  // inventory: Array of item objects [{ name: "Longsword", quantity: 1, equipped: true }]
  inventory Json @default("[]")

  // Notes & Lore
  backstory   String? @db.Text
  personality String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([campaignId])
}

model CharacterClass {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String    @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  className  String // e.g., Fighter, Wizard
  subclass   String? // e.g., Evocation, Circle of the Moon
  level      Int     @default(1)
  isStarting Boolean @default(false) // first class taken; determines multiclass proficiencies

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([characterId, className])
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  FINISHED
}

model Campaign {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?        @db.Text
  inviteCode  String         @unique // 6-character unique join code
  status      CampaignStatus @default(PLANNING)

  // DM is the single source of truth; CampaignMember rows are players only
  dmId String @db.Uuid
  dm   User   @relation("DMCampaigns", fields: [dmId], references: [id], onDelete: Restrict)

  members           CampaignMember[]
  characters        Character[]
  notes             CampaignNote[]
  gameSessions      GameSession[]
  compendiumEntries CompendiumEntry[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([dmId])
}

model CampaignMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  joinedAt  DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([campaignId, userId])
}

model CampaignNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  // Optional: set for session notes, null for general campaign notes
  gameSessionId String?      @db.Uuid
  gameSession   GameSession? @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  title    String
  content  Json // TipTap / BlockNote JSON format for rich text
  isDmOnly Boolean @default(false) // Secrets / DM-only view filter

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([campaignId])
  @@index([gameSessionId])
  @@index([authorId])
}

// A played session; its log lives in CampaignNote rows (DM-only and player-visible)
model GameSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  sessionNumber Int
  title         String
  playedAt      DateTime? @db.Timestamptz(3)

  notes CampaignNote[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([campaignId, sessionNumber])
  @@index([authorId])
}

// ------------------------------------------------------
// Campaign Compendium & World Lore Models
// ------------------------------------------------------

enum CompendiumCategory {
  LORE
  FACTION
  PANTHEON
  BESTIARY
  RELIC
  LOCATION
}

model CompendiumEntry {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String // e.g. "lady-of-pain", "harmonium"; unique within a campaign
  title       String
  category    CompendiumCategory
  summary     String?            @db.Text
  content     Json // Rich text (TipTap/BlockNote) or Markdown JSON
  imageUrl    String?
  tags        String[]           @default([]) // ["outer-planes", "deity"]
  isPublished Boolean            @default(false)

  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@unique([campaignId, slug])
  @@index([campaignId, category])
  @@index([authorId])
}
